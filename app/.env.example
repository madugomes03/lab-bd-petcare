# Copie este arquivo para ".env" (que NÃO vai para o Git) e preencha os valores reais.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petcare_db
DB_USER=root
DB_PASSWORD=troque-esta-senha

# Chave usada para assinar a sessão e o token CSRF. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# 1 = mostra, na tela de avaliação, a opção de simular falha no meio da transação (demonstração de ROLLBACK).
DEMO_FALHA=0
